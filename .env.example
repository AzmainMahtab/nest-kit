# Environment
NODE_ENV=development
API_PORT=3000
DEBUG_PORT=9229
IMAGE_TAG=latest

# HTTP
# /health and /metrics are excluded from the prefix so probes never move.
API_PREFIX=api
# URI versioning: routes are served at /api/v1/... A route pinned with
# @Version('2') keeps working when this default moves.
API_DEFAULT_VERSION=1
# Comma-separated allowlist. Empty disables CORS entirely — never use "*".
CORS_ORIGINS=
# Only enable behind a proxy you control that sets X-Forwarded-For. When true,
# the rate limiter believes that header — a client can otherwise forge it and
# mint itself an unlimited supply of fresh budgets.
TRUST_PROXY=false

# Observability
# json is what Loki and every other collector index; pretty is for a human at
# a terminal. Defaults to pretty outside production.
LOG_LEVEL=log
LOG_FORMAT=pretty
# Serves GET /metrics in the Prometheus text format. Public and unversioned,
# like the probes — keep it on an internal network or behind the proxy.
METRICS_ENABLED=true
# A readiness probe is on the critical path of a deploy: it must fail fast
# rather than hang while the orchestrator waits.
HEALTH_CHECK_TIMEOUT_MS=2000

# Rate limiting — a fixed window per client IP, shared across replicas in Redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
# Its own budget for login, refresh and registration: the global one is far too
# generous for password guessing.
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Observability stack (docker-compose.observability.yml, `make obs-up`)
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
# Local-only defaults. Change both before running this anywhere shared.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb
DATABASE_URL=postgres://app:app@postgres:5432/appdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# NATS JetStream — the outbox relay's transport
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
# Stream retention. Consumers must keep up within this window.
NATS_MAX_AGE_MS=604800000

# Outbox relay
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# After this many failed publish attempts a row is dead-lettered and skipped.
OUTBOX_MAX_ATTEMPTS=5

# Durable consumers (JetStream)
DURABLE_CONSUMER_ENABLED=true
# Deliveries before a message is dead-lettered to messaging.dead_letters.
DURABLE_MAX_DELIVER=5
DURABLE_ACK_WAIT_MS=30000
DURABLE_NAK_DELAY_MS=2000

# JWT — ES256 keypair, generated by `make keygen`. Never commit certs/.
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# RBAC
# How long a user's resolved roles and permissions stay cached in Redis.
# Assigning or revoking evicts the entry immediately; this only bounds how long
# a *lost* eviction can keep a revoked grant alive. Keep it short.
RBAC_CACHE_TTL_SECONDS=60

# Seeding — read by `make seed` only; the running application never uses these.
# The first administrator. Something has to break the circularity: assigning a
# role requires `rbac:admin`, which only the seeded `admin` role holds. Leave
# either empty to seed roles and permissions without provisioning an account.
SEED_SUPERADMIN_EMAIL=
# Minimum 12 characters, the same floor registration enforces. An existing
# account is never rewritten, so changing this does not reset a password.
SEED_SUPERADMIN_PASSWORD=
# Seeding refuses a database host that is not obviously local, so a .env pointed
# at a shared database cannot be seeded by reflex. Set true to override.
ALLOW_REMOTE_SEED=false

# Production resource limits (docker-compose.prod.yml)
API_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m

# Object storage — the S3 API, not necessarily AWS
# Empty endpoint means AWS. Anything else is MinIO, Cloudflare R2, Backblaze,
# Wasabi or another implementation; the adapter does not know the difference.
# `make dev` runs MinIO in the compose network, where the host name is `minio`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nest-kit
# Local-only defaults, matching the MinIO container. In production leave BOTH
# empty so the SDK resolves an instance role or IRSA instead — empty strings
# passed as credentials would defeat that.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and most self-hosted stores cannot do virtual-host addressing without
# wildcard DNS. Set false for AWS.
S3_FORCE_PATH_STYLE=true
# How long a presigned upload or download URL stays valid, in seconds.
S3_PRESIGN_EXPIRY_SECONDS=900
# Published by the dev overlay so a browser on the host can reach the console.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Refused by multer while the part is still streaming, so an oversized upload
# never reaches memory. 25 MiB.
UPLOAD_MAX_BYTES=26214400
# JSON and urlencoded bodies only. Multipart is bounded by UPLOAD_MAX_BYTES.
BODY_LIMIT=1mb

# Mail
# Off by default: the log adapter records UNCONFIGURED rather than reporting a
# success nobody received. Turn it on once a real transport is wired in.
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.test
# How often queued notifications are swept, how many per sweep, and how many
# attempts each gets before it stops being retried and becomes a question.
NOTIFICATION_DISPATCH_INTERVAL_MS=5000
NOTIFICATION_DISPATCH_BATCH=50
NOTIFICATION_MAX_ATTEMPTS=5

# Scheduler — timed work, one replica per tick
SCHEDULER_ENABLED=true
# The lock's safety net for a dead process, not a task timeout. It must
# comfortably exceed the longest task or a second replica picks the work up.
SCHEDULER_LOCK_TTL_MS=60000

# Outbound calls — one timeout, retry policy and breaker for every integration
UPSTREAM_TIMEOUT_MS=5000
# Retries apply to GET/HEAD/PUT/DELETE. A POST opts in explicitly, because the
# retry that turns one charge into two is the expensive kind of bug.
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_MS=100
UPSTREAM_RETRY_MAX_MS=2000
# Consecutive failures to one host before calls to it are suspended.
UPSTREAM_BREAKER_THRESHOLD=5
UPSTREAM_BREAKER_RESET_MS=30000
